{
  "expo": {
    "name": "NSTP HUB",
    "slug": "nstp-hub",
    "owner": "nstp-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nstphub",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.nstphub.mobile",

      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      "expo-dev-client",

      "@react-native-google-signin/google-signin/app.plugin.js",

      [
        "expo-image-picker",
        {
          "photosPermission": "NSTP HUB needs access to your photos so you can select a student profile picture.",
          "cameraPermission": "NSTP HUB needs access to your camera so you can take a student profile picture.",
          "microphonePermission": false
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nstphub_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EFEBE2",

          "dark": {
            "backgroundColor": "#EFEBE2"
          }
        }
      ],

      "expo-secure-store",

      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},

      "eas": {
        "projectId": "1e34660d-32ab-4746-bba5-fe0a64345437"
      }
    }
  }
}